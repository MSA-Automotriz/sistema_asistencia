# Puerto HTTP donde escucha la API.
#PORT=3000
# Entorno de ejecución: development, test o production.
#NODE_ENV=production
# Nombre visible de la aplicación.
#APP_NAME="MSA Asistencia API"
# Claves secretas usadas para firmar los tokens JWT (mínimo 32 caracteres).
#JWT_SECRET="genera_un_secreto_seguro_de_al_menos_32_caracteres"
#JWT_REFRESH_SECRET="genera_otro_secreto_seguro_de_al_menos_32_caracteres"
# Tiempo de validez de los tokens.
#JWT_EXPIRES_IN=1d
#JWT_REFRESH_EXPIRES_IN=30d
#JWT_REMEMBER_ME_EXPIRES_IN=90d
# Cadena de conexión a MySQL.
#DATABASE_URL="mysql://usuario:password@localhost:3306/asistencia_msa"
# Configuración del servidor SMTP para notificaciones por correo electrónico.
#SMTP_HOST=smtp.gmail.com
#SMTP_PORT=587
#SMTP_USER=notificaciones@msaautomotriz.com
#SMTP_PASSWORD=tu_contraseña_o_app_password
#SMTP_FROM=notificaciones@msaautomotriz.com
# Nivel de detalle de los logs (info, warn, error, debug).
#LOG_LEVEL=info
# Horas de vigencia de registros de asistencia offline antes de expirar.
#OFFLINE_ATTENDANCE_EXPIRATION_HOURS=24
# Distancia máxima permitida para validar la ubicación GPS respecto a la sede, en metros.
#GPS_RADIUS_METERS=10
# Orígenes permitidos para las solicitudes CORS (ej: https://asistencia.msaautomotriz.com o *).
#CORS_ORIGIN=https://asistencia.msaautomotriz.com
# Directorio local de respaldos.
#BACKUP_DIRECTORY="logs/backups"
# Ruta explícita a mysqldump (opcional si está en el PATH del sistema operativo).
#MYSQLDUMP_PATH="/usr/bin/mysqldump"
# Configuración de Notificaciones Web Push (VAPID). Generar con: npx web-push generate-vapid-keys
#VAPID_PUBLIC_KEY=
#VAPID_PRIVATE_KEY=
#VAPID_SUBJECT=mailto:contacto@msaautomotriz.com