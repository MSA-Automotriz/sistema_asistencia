# Puerto HTTP donde escucha la API.
#PORT=3000
# Entorno de ejecución: development, test o production.
#NODE_ENV=development
# Nombre visible de la aplicación.
#APP_NAME=MSA Asistencia API
# Claves secretas usadas para firmar los tokens JWT.
#JWT_SECRET=
#JWT_REFRESH_SECRET=
# Tiempo de validez del token de acceso.
#JWT_EXPIRES_IN=1d
# Tiempo de validez del token de renovación.
#JWT_REFRESH_EXPIRES_IN=30d
# Tiempo de validez cuando se selecciona "recordarme".
#JWT_REMEMBER_ME_EXPIRES_IN=90d
# Cadena de conexión a MySQL.
#DATABASE_URL="mysql://root:password@localhost:3306/asistencia_msa"
# Configuración del servidor SMTP para enviar correos.
#MAIL_HOST=
#MAIL_PORT=
#MAIL_USER=
#MAIL_PASSWORD=
#MAIL_FROM=
# Nivel de detalle de los logs.
#LOG_LEVEL=debug
# Tiempo de validez de un código QR, en segundos.
#QR_EXPIRATION_SECONDS=60
# Distancia máxima permitida para validar la ubicación, en metros.
#GPS_RADIUS_METERS=10
# Orígenes permitidos para las solicitudes CORS.
#CORS_ORIGIN=http://localhost:3000